{
  "name": "stocklocal",
  "private": true,
  "version": "1.0.0",
  "description": "Application desktop de gestion commerciale pour grossistes",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc && vite build && electron-builder",
    "preview": "vite preview",
    "postinstall": "electron-builder install-app-deps",
    "test": "node scripts/run-tests-electron.cjs run",
    "test:watch": "node scripts/run-tests-electron.cjs watch"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.9",
    "better-sqlite3": "^13.0.3",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.33.0",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.1.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.5.4",
    "vite": "^5.3.4",
    "vite-plugin-electron": "^0.28.7",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^2.1.9"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "electron@43.4.1": true,
    "esbuild@0.21.5": true
  },
  "build": {
    "appId": "com.stocklocal.app",
    "productName": "StockLocal",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "src/database/schema",
        "to": "schema"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "StockLocal"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://mises-a-jour.stocklocal.ma/win"
      }
    ]
  }
}
